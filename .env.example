# Database Configuration for local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
DB_SCHEMA=dados
DB_TABLE=registro

# Mode indicator (production or development)
NODE_ENV=development

# Gemini API Key (Server-Side Only)
GEMINI_API_KEY=

# Staff authentication (server-only; never use a VITE_ prefix)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
RECEPTION_USERNAME=admin
RECEPTION_PASSWORD=
SESSION_SECRET=
